# If set, requests must include header: X-API-Key: <value>
BACKEND_API_KEY=

# Gemini 1.5
## IMPORTANT: never commit real API keys. Put your key in backend/.env (gitignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
## Optional: run multiple Gemini models (comma-separated) for ensembling
# GEMINI_MODELS=gemini-1.5-flash,gemini-1.5-pro
# GEMINI_MAX_MODELS=3
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=900

# Prefer using a prompt file (easier than multiline env values)
GEMINI_SYSTEM_PROMPT_PATH=./prompts/gemini_1_5_system.txt
# Optional override (if set, overrides the file)
GEMINI_SYSTEM_PROMPT=

# Optional: Link reputation (Google Safe Browsing)
SAFE_BROWSING_API_KEY=

# SQLite DB file
DATABASE_PATH=./data/app.sqlite3

# Raw data retention TTL (seconds) for interaction metadata
RETENTION_TTL_SECONDS=604800

# Simple in-memory rate limit (requests per minute per key/IP)
RATE_LIMIT_RPM=60
